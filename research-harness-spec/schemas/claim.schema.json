{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research harness claim v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "text",
    "kind",
    "materiality",
    "manuscript",
    "evidence",
    "support",
    "dependencies",
    "created_at",
    "producer",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^C-[0-9]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "external",
        "own_numeric",
        "interpretation",
        "hypothesis"
      ]
    },
    "materiality": {
      "enum": [
        "critical",
        "material",
        "background"
      ]
    },
    "manuscript": {
      "type": "object",
      "required": [
        "path",
        "locator",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "support": {
      "enum": [
        "unreviewed",
        "supported",
        "partial",
        "contradicted",
        "insufficient"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        },
        "additionalProperties": false
      }
    },
    "result_ref": {
      "type": "string"
    },
    "expected_tuple": {
      "type": "object",
      "required": [
        "dataset_id",
        "split_id",
        "condition",
        "metric_id",
        "unit",
        "aggregation"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "split_id": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "metric_id": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "aggregation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "tool",
            "model"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "own_numeric"
          }
        }
      },
      "then": {
        "required": [
          "result_ref",
          "expected_tuple"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "support": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "dependencies": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
