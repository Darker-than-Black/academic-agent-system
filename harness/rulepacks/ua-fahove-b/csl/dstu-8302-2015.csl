<?xml version="1.0" encoding="utf-8"?>
<!--
  Clean-room CSL for ДСТУ 8302:2015 (Bibliographic reference).
  Written for the Research Harness (Apache-2.0); NOT the text of the standard and
  NOT derived from any third-party CSL (so no external licence applies, H4).
  Validated 2026-11-04 against ДСТУ 8302:2015 / МОН Наказ № 928 on 10 real
  references (see csl/examples/ + csl/dstu-8302-2015.csl.status.yaml). Numeric,
  sorted; renders "Автор І. Назва. Контейнер. Рік. Т. X, № Y. С. nn—nn. DOI:"
  (and "URL: … (дата звернення: ДД.ММ.РРРР)" for electronic resources).
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="uk-UA" page-range-format="expanded">
  <info>
    <title>ДСТУ 8302:2015 (Research Harness)</title>
    <id>https://rh.spec/csl/dstu-8302-2015</id>
    <updated>2026-11-04T00:00:00+00:00</updated>
    <category citation-format="numeric"/>
    <summary>Clean-room CSL for ДСТУ 8302:2015; validated against МОН Наказ № 928.</summary>
  </info>
  <locale xml:lang="uk">
    <terms>
      <term name="page" form="short">С.</term>
      <term name="volume" form="short">Т.</term>
      <term name="issue" form="short">№</term>
      <term name="page-range-delimiter">—</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", "/>
    </names>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="author"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="" suffix=". "/>
      <group delimiter=". ">
        <text macro="author"/>
        <text variable="title"/>
        <text variable="container-title"/>
        <date variable="issued"><date-part name="year"/></date>
      </group>
      <group prefix=". " delimiter=". ">
        <group delimiter=", ">
          <group><label variable="volume" form="short" suffix=" "/><text variable="volume"/></group>
          <group><label variable="issue" form="short" suffix=" "/><text variable="issue"/></group>
        </group>
        <group><label variable="page" form="short" suffix=" "/><text variable="page"/></group>
      </group>
      <text variable="DOI" prefix=". DOI: "/>
      <text variable="URL" prefix=". URL: "/>
      <date variable="accessed" prefix=" (дата звернення: " suffix=")">
        <date-part name="day" form="numeric-leading-zeros" suffix="."/>
        <date-part name="month" form="numeric-leading-zeros" suffix="."/>
        <date-part name="year"/>
      </date>
    </layout>
  </bibliography>
</style>
