{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rh.spec/schemas/workspace.schema.json",
  "title": ".rh-workspace.json (02 §3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "counters", "objects"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^W-[0-9A-HJKMNP-TV-Z]{26}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "counters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "folder"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["article", "thesis"] },
          "folder": { "type": "string" }
        }
      }
    }
  }
}
