{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rh.spec/schemas/model-call.schema.json",
  "title": ".rh/model-calls.jsonl line (02 §10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "at", "host", "role", "tier_required", "model_id", "purpose", "tokens_in", "tokens_out", "cost", "duration_s", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^mc-[0-9A-HJKMNP-TV-Z]{26}$" },
    "at": { "$ref": "common.schema.json#/$defs/datetime" },
    "host": { "type": "string" },
    "role": { "type": "string" },
    "tier_required": { "enum": ["flagship", "strong", "fast", "none"] },
    "model_id": { "type": "string" },
    "downgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_tier", "to_tier", "reason"],
      "properties": {
        "from_tier": { "type": "string" },
        "to_tier": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "purpose": { "type": "string" },
    "context_pack": { "type": "string" },
    "tokens_in": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "unknown" }] },
    "tokens_out": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "unknown" }] },
    "cost": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "duration_s": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "status": { "enum": ["ok", "failed"] },
    "operation_id": { "type": "string", "pattern": "^op-[0-9A-HJKMNP-TV-Z]{26}$" }
  }
}
