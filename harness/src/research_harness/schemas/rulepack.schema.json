{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rh.spec/schemas/rulepack.schema.json",
  "title": "pack.yaml (02 §8.1)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["id", "name", "version", "layer", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "layer": { "type": "integer", "minimum": 0, "maximum": 7 },
    "status": { "$ref": "common.schema.json#/$defs/pack_status" },
    "applies_when": { "type": "object" },
    "description": { "type": "string" }
  }
}
