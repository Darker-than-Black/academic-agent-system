{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rh.spec/schemas/premise.schema.json",
  "title": "Premise / Definition (02 §12, def M1 / impl M2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "producer", "kind", "statement"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^(P-[0-9]{4,}|DEF-[0-9]{3,})$" },
    "created_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "producer": { "$ref": "common.schema.json#/$defs/producer" },
    "kind": { "enum": ["premise", "definition"] },
    "term": { "type": "string" },
    "statement": { "type": "string" },
    "excerpt_ids": { "type": "array", "items": { "type": "string", "pattern": "^E-[0-9]{5,}$" } },
    "assumption": { "type": "boolean" }
  },
  "anyOf": [
    { "required": ["excerpt_ids"], "properties": { "excerpt_ids": { "minItems": 1 } } },
    { "required": ["assumption"], "properties": { "assumption": { "const": true } } }
  ]
}
