{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rh.spec/schemas/verdict.schema.json",
  "title": "Reviewer verdict (review.md §Owned-files; M3-02, FR-07/FR-09)",
  "description": "One critic assessment of a claim. Every verdict other than 'unreviewed' carries at least one evidence ref and a rationale (invariant 3): a 'supported' (or any non-unreviewed) verdict with empty evidence is rejected by this schema and by rh review submit (review.verdict_without_evidence).",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "support"],
  "properties": {
    "claim_id": { "type": "string", "minLength": 1 },
    "support": { "$ref": "common.schema.json#/$defs/support" },
    "rationale": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "access_level": { "enum": ["full", "abstract", "metadata", "unknown"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "by": { "type": "string" },
    "at": { "$ref": "common.schema.json#/$defs/datetime" }
  },
  "allOf": [
    {
      "if": {
        "required": ["support"],
        "properties": { "support": { "not": { "const": "unreviewed" } } }
      },
      "then": {
        "required": ["evidence_refs", "rationale"],
        "properties": {
          "evidence_refs": { "minItems": 1 },
          "rationale": { "minLength": 1 }
        }
      }
    }
  ]
}
